# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build and test on simulator"
  lane :test do
    run_tests(
      scheme:         "JumpTuner",
      destination:    "platform=iOS Simulator,OS=latest,name=iPhone 17 Pro",
      result_bundle:  true
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "JumpTuner.xcodeproj"
    )
    build_app(scheme: "JumpTuner")
    upload_to_testflight
  end

  # ── App Store asset lanes ────────────────────────────────────────────────────

  desc "Umbrella lane: generate all App Store assets (screenshots + marketing GIFs)"
  lane :store_assets do
    UI.message("Generating App Store screenshots…")
    screenshots

    UI.message("Generating marketing GIFs…")
    marketing_gifs

    UI.success("All store assets written to fastlane/screenshots and fastlane/marketing")
  end

  desc "Capture App Store screenshots on all required device sizes via snapshot"
  lane :screenshots do
    # snapshot requires a JumpTunerUITests UI test target with snapshot() calls.
    # If the target does not exist yet this lane prints instructions and exits.
    targets = sh("xcodebuild -list -project JumpTuner.xcodeproj 2>/dev/null | grep -i 'UITest' || true").strip
    if targets.empty?
      UI.important <<~MSG
        No UI test target found.
        To enable automated screenshots:
          1. In Xcode: File → New → Target → UI Testing Bundle → "JumpTunerUITests"
          2. Add `import XCTest` and call `snapshot("01_home")` at key moments.
          3. Re-run: bundle exec fastlane screenshots
      MSG
      next
    end

    capture_ios_screenshots(
      scheme:                    "JumpTuner",
      output_directory:          "fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar:       true,
      reinstall_app:             true
    )
  end

  desc "Record a simulator screen capture for each device and convert to animated GIF"
  lane :marketing_gifs do
    device_configs = [
      { name: "iPhone 16 Pro Max", label: "6_9_inch" },
      { name: "iPhone 16 Pro",     label: "6_3_inch" }
    ]
    duration   = ENV.fetch("GIF_DURATION", "10").to_i
    output_dir = File.expand_path("../fastlane/marketing", __dir__)
    script     = File.expand_path("../scripts/record_gif.sh", __dir__)

    FileUtils.mkdir_p(output_dir)

    device_configs.each do |cfg|
      UI.message("Recording #{cfg[:name]}…")
      sh(
        "DERIVED_DATA_PATH=/tmp/JumpTunerDerivedData " \
        "bash '#{script}' '#{cfg[:name]}' #{duration} '#{output_dir}'",
        error_callback: ->(result) {
          UI.error("Recording failed for #{cfg[:name]}: #{result}")
        }
      )
    end

    gifs = Dir.glob("#{output_dir}/*.gif")
    if gifs.empty?
      UI.important("No GIFs were produced. Ensure ffmpeg is installed (brew install ffmpeg).")
    else
      UI.success("GIFs created:")
      gifs.each { |g| UI.message("  #{g}") }
    end
  end

  # ── CI distribution lanes ────────────────────────────────────────────────────
  #
  #   PRs   → pr_adhoc   → Zealot (zealot.jeffro.dev), unique bundle ID per PR so
  #                         several PR builds can be installed side by side.
  #   main  → main_beta  → TestFlight with the real bundle ID.

  APP_BUNDLE_ID      = "visceralorigami.JumpTuner"
  ADHOC_APP_ID       = "visceralorigami.*"           # wildcard App ID (portal)
  ADHOC_PROFILE_NAME = "JumpTuner AdHoc Wildcard"

  private_lane :ci_api_key do
    app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )
  end

  desc "main → TestFlight (real bundle ID). Run by .github/workflows/main-beta.yml"
  lane :main_beta do
    profile_b64 = ENV["PROVISIONING_PROFILE_BASE64"]
    UI.user_error!("PROVISIONING_PROFILE_BASE64 secret is not set") if profile_b64.nil? || profile_b64.empty?
    profile_path = "/tmp/profile.mobileprovision"
    File.binwrite(profile_path, Base64.decode64(profile_b64))
    install_provisioning_profile(path: profile_path)

    api_key = ci_api_key

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj:    "JumpTuner.xcodeproj"
    )

    build_app(
      scheme:        "JumpTuner",
      export_method: "app-store",
      xcargs:        "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='JumpTunerDist'",
      export_options: {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: { APP_BUNDLE_ID => "JumpTunerDist" }
      }
    )

    changelog = ENV.fetch("CHANGELOG") { sh("git log -1 --pretty=%s", log: false).strip }
    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      changelog:                         changelog
    )
  end

  desc "PR → ad hoc build with bundle ID visceralorigami.JumpTuner.pr<N>, uploaded to Zealot"
  lane :pr_adhoc do
    pr_number = ENV.fetch("PR_NUMBER") { UI.user_error!("PR_NUMBER is not set") }
    pr_title  = ENV.fetch("PR_TITLE", "PR build")
    branch    = ENV.fetch("PR_BRANCH") { git_branch }
    bundle_id = "#{APP_BUNDLE_ID}.pr#{pr_number}"
    build_num = ENV.fetch("GITHUB_RUN_NUMBER") { Time.now.strftime("%Y%m%d%H%M") }

    # Fetches (or creates) the wildcard ad hoc profile containing every
    # registered device. Set ADHOC_FORCE=true to regenerate it after adding devices.
    sigh(
      adhoc:            true,
      app_identifier:   ADHOC_APP_ID,
      provisioning_name: ADHOC_PROFILE_NAME,
      force:            ENV["ADHOC_FORCE"] == "true",
      api_key:          ci_api_key
    )

    ipa = build_app(
      scheme:        "JumpTuner",
      configuration: "Release",
      export_method: "ad-hoc",
      output_name:   "JumpTuner-pr#{pr_number}.ipa",
      xcargs: [
        "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
        "INFOPLIST_KEY_CFBundleDisplayName='JT PR#{pr_number}'",
        "CURRENT_PROJECT_VERSION=#{build_num}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{ADHOC_PROFILE_NAME}'"
      ].join(" "),
      export_options: {
        method:               "ad-hoc",
        signingStyle:         "manual",
        provisioningProfiles: { bundle_id => ADHOC_PROFILE_NAME }
      }
    )

    zealot_upload(
      ipa:       ipa,
      branch:    branch,
      changelog: "PR ##{pr_number}: #{pr_title}"
    )
  end

  desc "Upload an IPA to Zealot. Needs ZEALOT_TOKEN; ZEALOT_RESOLVE_IP pins DNS (CI over Tailscale)"
  private_lane :zealot_upload do |options|
    require "json"
    require "shellwords"
    host  = ENV.fetch("ZEALOT_HOST", "zealot.jeffro.dev")
    token = ENV.fetch("ZEALOT_TOKEN") { UI.user_error!("ZEALOT_TOKEN is not set") }
    resolve = ENV["ZEALOT_RESOLVE_IP"].to_s.empty? ? "" : "--resolve #{host}:443:#{ENV['ZEALOT_RESOLVE_IP']}"
    ci_url = ENV["GITHUB_RUN_ID"] ? "#{ENV['GITHUB_SERVER_URL']}/#{ENV['GITHUB_REPOSITORY']}/actions/runs/#{ENV['GITHUB_RUN_ID']}" : ""

    fields = {
      "token"        => token,
      # JumpTuner → "PR Builds" → iOS channel on zealot.jeffro.dev (not secret; the token is).
      "channel_key"  => ENV.fetch("ZEALOT_CHANNEL_KEY", "f2ff8e00361966d29f9ad047c3240396"),
      "release_type" => "adhoc",
      "source"       => "github-actions",
      "branch"       => options[:branch],
      "git_commit"   => ENV.fetch("GITHUB_SHA") { last_git_commit[:commit_hash] },
      "changelog"    => options[:changelog],
      "ci_url"       => ci_url
    }
    form = fields.map { |k, v| "--form-string #{Shellwords.escape("#{k}=#{v}")}" }.join(" ")
    resp_file = "/tmp/zealot_response.json"
    code = sh(
      "curl -sS -o #{resp_file} -w '%{http_code}' #{resolve} #{form} -F file=@#{Shellwords.escape(options[:ipa])} https://#{host}/api/apps/upload",
      log: false
    ).strip
    body = File.exist?(resp_file) ? File.read(resp_file) : ""
    UI.user_error!("Zealot upload failed (HTTP #{code}): #{body[0, 1000]}") unless code.start_with?("2")
    release = JSON.parse(body) rescue {}
    url = release["release_url"] || release["install_url"] || "https://#{host}"
    UI.success("Uploaded to Zealot: #{url}")
    File.write(ENV["ZEALOT_RESULT_FILE"], url) if ENV["ZEALOT_RESULT_FILE"]
    url
  end

  desc "Register a device and regenerate the wildcard ad hoc profile. Usage: fastlane add_device name:\"Jeff iPhone\" udid:XXXX"
  lane :add_device do |options|
    api_key = ci_api_key
    register_devices(devices: { options[:name] => options[:udid] }, api_key: api_key)
    sigh(adhoc: true, app_identifier: ADHOC_APP_ID, provisioning_name: ADHOC_PROFILE_NAME,
         force: true, api_key: api_key, skip_install: true)
  end
end
