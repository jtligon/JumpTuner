# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require 'base64'

default_platform(:ios)

platform :ios do
  desc "Build and test on simulator"
  lane :test do
    run_tests(
      scheme:         "JumpTuner",
      destination:    "platform=iOS Simulator,OS=latest,name=iPhone 17 Pro",
      result_bundle:  true
    )
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "JumpTuner.xcodeproj"
    )
    build_app(scheme: "JumpTuner")
    upload_to_testflight
  end

  # ── App Store asset lanes ────────────────────────────────────────────────────

  desc "Umbrella lane: generate all App Store assets (screenshots + marketing GIFs)"
  lane :store_assets do
    UI.message("Generating App Store screenshots…")
    screenshots

    UI.message("Generating marketing GIFs…")
    marketing_gifs

    UI.success("All store assets written to fastlane/screenshots and fastlane/marketing")
  end

  desc "Capture App Store screenshots on all required device sizes via snapshot"
  lane :screenshots do
    # snapshot requires a JumpTunerUITests UI test target with snapshot() calls.
    # If the target does not exist yet this lane prints instructions and exits.
    targets = sh("xcodebuild -list -project JumpTuner.xcodeproj 2>/dev/null | grep -i 'UITest' || true").strip
    if targets.empty?
      UI.important <<~MSG
        No UI test target found.
        To enable automated screenshots:
          1. In Xcode: File → New → Target → UI Testing Bundle → "JumpTunerUITests"
          2. Add `import XCTest` and call `snapshot("01_home")` at key moments.
          3. Re-run: bundle exec fastlane screenshots
      MSG
      next
    end

    capture_ios_screenshots(
      scheme:                    "JumpTuner",
      output_directory:          "fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar:       true,
      reinstall_app:             true
    )
  end

  desc "Record a simulator screen capture for each device and convert to animated GIF"
  lane :marketing_gifs do
    device_configs = [
      { name: "iPhone 16 Pro Max", label: "6_9_inch" },
      { name: "iPhone 16 Pro",     label: "6_3_inch" }
    ]
    duration   = ENV.fetch("GIF_DURATION", "10").to_i
    output_dir = File.expand_path("../fastlane/marketing", __dir__)
    script     = File.expand_path("../scripts/record_gif.sh", __dir__)

    FileUtils.mkdir_p(output_dir)

    device_configs.each do |cfg|
      UI.message("Recording #{cfg[:name]}…")
      sh(
        "DERIVED_DATA_PATH=/tmp/JumpTunerDerivedData " \
        "bash '#{script}' '#{cfg[:name]}' #{duration} '#{output_dir}'",
        error_callback: ->(result) {
          UI.error("Recording failed for #{cfg[:name]}: #{result}")
        }
      )
    end

    gifs = Dir.glob("#{output_dir}/*.gif")
    if gifs.empty?
      UI.important("No GIFs were produced. Ensure ffmpeg is installed (brew install ffmpeg).")
    else
      UI.success("GIFs created:")
      gifs.each { |g| UI.message("  #{g}") }
    end
  end

  desc "Build a PR branch and upload to TestFlight for review"
  lane :pr_beta do
    pr_number = ENV.fetch("PR_NUMBER", "0")
    pr_title  = ENV.fetch("PR_TITLE",  "PR build")

    # Install provisioning profile
    profile_b64 = ENV["PROVISIONING_PROFILE_BASE64"]
    UI.user_error!("PROVISIONING_PROFILE_BASE64 secret is not set") if profile_b64.nil? || profile_b64.empty?
    profile_path = "/tmp/profile.mobileprovision"
    File.binwrite(profile_path, Base64.decode64(profile_b64))
    install_provisioning_profile(path: profile_path)

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj:    "JumpTuner.xcodeproj"
    )

    build_app(
      scheme:        "JumpTuner",
      export_method: "app-store",
      xcargs:        "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='JumpTunerDist'",
      export_options: {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: { "visceralorigami.JumpTuner" => "JumpTunerDist" }
      }
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      changelog:                         "PR ##{pr_number}: #{pr_title}"
    )
  end
end
